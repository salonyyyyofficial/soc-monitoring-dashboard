<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h3 class="mb-0">Dashboard</h3>
    <div class="text-secondary small">Security overview</div>
  </div>
  <span class="badge bg-success"><i class="bi bi-broadcast me-1"></i>Live</span>
</div>

<div class="row g-3 mb-4">
  <div class="col-6 col-md-4 col-xl-2">
    <div class="card stat-card"><div class="card-body">
      <div class="text-secondary small">TOTAL EVENTS</div>
      <div class="fs-3 fw-bold" id="stat-total-events"><%= stats.totalEvents %></div>
    </div></div>
  </div>
  <div class="col-6 col-md-4 col-xl-2">
    <div class="card stat-card border-danger"><div class="card-body">
      <div class="text-secondary small">CRITICAL ALERTS</div>
      <div class="fs-3 fw-bold text-danger" id="stat-critical-alerts"><%= stats.criticalAlerts %></div>
    </div></div>
  </div>
  <div class="col-6 col-md-4 col-xl-2">
    <div class="card stat-card border-warning"><div class="card-body">
      <div class="text-secondary small">HIGH ALERTS</div>
      <div class="fs-3 fw-bold text-warning" id="stat-high-alerts"><%= stats.highAlerts %></div>
    </div></div>
  </div>
  <div class="col-6 col-md-4 col-xl-2">
    <div class="card stat-card"><div class="card-body">
      <div class="text-secondary small">OPEN INCIDENTS</div>
      <div class="fs-3 fw-bold"><%= stats.openIncidents %></div>
    </div></div>
  </div>
  <div class="col-6 col-md-4 col-xl-2">
    <div class="card stat-card"><div class="card-body">
      <div class="text-secondary small">MALICIOUS IPs</div>
      <div class="fs-3 fw-bold"><%= stats.maliciousIps %></div>
    </div></div>
  </div>
  <div class="col-6 col-md-4 col-xl-2">
    <div class="card stat-card"><div class="card-body">
      <div class="text-secondary small">ACTIVE ASSETS</div>
      <div class="fs-3 fw-bold"><%= stats.activeAssets %></div>
    </div></div>
  </div>
</div>

<div class="row g-3">
  <div class="col-lg-8">
    <div class="card"><div class="card-body">
      <h6 class="text-secondary text-uppercase small mb-3">Events (Last 24 Hours)</h6>
      <canvas id="timelineChart" height="90"></canvas>
    </div></div>
  </div>
  <div class="col-lg-4">
    <div class="card"><div class="card-body">
      <h6 class="text-secondary text-uppercase small mb-3">Alert Severity</h6>
      <canvas id="severityChart" height="180"></canvas>
    </div></div>
  </div>
  <div class="col-lg-4">
    <div class="card"><div class="card-body">
      <h6 class="text-secondary text-uppercase small mb-3">Event Sources</h6>
      <canvas id="sourcesChart" height="180"></canvas>
    </div></div>
  </div>
  <div class="col-lg-4">
    <div class="card"><div class="card-body">
      <h6 class="text-secondary text-uppercase small mb-3">Top Attacking IPs</h6>
      <canvas id="ipsChart" height="180"></canvas>
    </div></div>
  </div>
  <div class="col-lg-4">
    <div class="card"><div class="card-body">
      <h6 class="text-secondary text-uppercase small mb-3">Top Detection Rules</h6>
      <canvas id="rulesChart" height="180"></canvas>
    </div></div>
  </div>
</div>

<div id="chartData"
  data-timeline-labels='<%- JSON.stringify(charts.timeline.labels) %>'
  data-timeline-values='<%- JSON.stringify(charts.timeline.data) %>'
  data-severity='<%- JSON.stringify(charts.severity) %>'
  data-sources='<%- JSON.stringify(charts.sources) %>'
  data-topips='<%- JSON.stringify(charts.topIps) %>'
  data-toprules='<%- JSON.stringify(charts.topRules) %>'
></div>
