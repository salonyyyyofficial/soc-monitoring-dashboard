<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h3 class="mb-0">Reports</h3>
    <div class="text-secondary small">Generated <%= new Date(report.generated_at).toLocaleString() %></div>
  </div>
  <div>
    <a href="/reports/export.csv" class="btn btn-outline-light btn-sm"><i class="bi bi-filetype-csv me-1"></i>CSV</a>
    <a href="/reports/export.json" class="btn btn-outline-light btn-sm"><i class="bi bi-filetype-json me-1"></i>JSON</a>
  </div>
</div>

<div class="row g-3 mb-4">
  <% const cards = [
    ['Total Events', report.summary.totalEvents, ''],
    ['Total Alerts', report.summary.totalAlerts, ''],
    ['Critical Alerts', report.summary.criticalAlerts, 'text-danger'],
    ['High Alerts', report.summary.highAlerts, 'text-warning'],
    ['Open Incidents', report.summary.openIncidents, ''],
    ['Total Assets', report.summary.totalAssets, '']
  ]; %>
  <% cards.forEach(([label, value, cls]) => { %>
    <div class="col-6 col-md-4 col-xl-2">
      <div class="card stat-card"><div class="card-body">
        <div class="text-secondary small"><%= label.toUpperCase() %></div>
        <div class="fs-3 fw-bold <%= cls %>"><%= value %></div>
      </div></div>
    </div>
  <% }) %>
</div>

<div class="row g-3">
  <div class="col-md-6">
    <div class="card">
      <div class="card-body pb-0"><h6 class="text-secondary text-uppercase small mb-3">Top Attacking IPs</h6></div>
      <div class="table-responsive">
        <table class="table table-dark table-sm mb-0">
          <thead><tr><th>Source IP</th><th>Alerts</th></tr></thead>
          <tbody>
            <% if (report.topAttackingIps.length === 0) { %>
              <tr><td colspan="2" class="text-center text-secondary py-3">No data yet.</td></tr>
            <% } %>
            <% report.topAttackingIps.forEach(r => { %>
              <tr><td class="small"><%= r.source_ip %></td><td class="small fw-bold"><%= r.count %></td></tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <div class="col-md-6">
    <div class="card">
      <div class="card-body pb-0"><h6 class="text-secondary text-uppercase small mb-3">Top Detection Rules</h6></div>
      <div class="table-responsive">
        <table class="table table-dark table-sm mb-0">
          <thead><tr><th>Rule</th><th>Alerts</th></tr></thead>
          <tbody>
            <% if (report.topDetectionRules.length === 0) { %>
              <tr><td colspan="2" class="text-center text-secondary py-3">No data yet.</td></tr>
            <% } %>
            <% report.topDetectionRules.forEach(r => { %>
              <tr><td class="small"><%= r.rule_name %></td><td class="small fw-bold"><%= r.count %></td></tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<div class="alert alert-secondary mt-3">
  <i class="bi bi-info-circle me-1"></i>
  PDF export is intentionally left out of this version to keep dependencies light. CSV and JSON cover the same data.
</div>
