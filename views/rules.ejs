<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h3 class="mb-0">Detection Rules</h3>
    <div class="text-secondary small"><%= rules.length %> rule(s) loaded</div>
  </div>
</div>

<div class="card">
  <div class="table-responsive">
    <table class="table table-dark table-hover align-middle mb-0">
      <thead>
        <tr>
          <th>Name</th>
          <th>Description</th>
          <th>Severity</th>
          <th>Type</th>
          <th>MITRE</th>
          <th>Status</th>
        </tr>
      </thead>
      <tbody>
        <% rules.forEach(rule => { %>
          <tr>
            <td class="fw-semibold small"><%= rule.title %></td>
            <td class="small text-secondary" style="max-width: 400px;"><%= rule.description %></td>
            <td>
              <% const badgeClass = { CRITICAL: 'badge-critical', HIGH: 'badge-high', MEDIUM: 'badge-medium', LOW: 'badge-low' }[rule.severity] || 'badge-info'; %>
              <span class="badge <%= badgeClass %>"><%= rule.severity %></span>
            </td>
            <td class="small text-secondary"><%= rule.rule_type %></td>
            <td class="small"><%= rule.mitre_id || '—' %></td>
            <td>
              <% if (rule.enabled) { %>
                <span class="badge bg-success">Enabled</span>
              <% } else { %>
                <span class="badge bg-secondary">Disabled</span>
              <% } %>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>

<div class="alert alert-secondary mt-3">
  <i class="bi bi-info-circle me-1"></i>
  These rules run automatically whenever a new event is logged (e.g. via the Simulator). Enabling/disabling and editing rules from this page arrives in a later step.
</div>
