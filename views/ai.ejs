<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h3 class="mb-0">AI Security Analyst</h3>
    <div class="text-secondary small">Provider: <%= provider %></div>
  </div>
</div>

<% if (!aiEnabled) { %>
  <div class="alert alert-warning">
    <i class="bi bi-exclamation-triangle me-1"></i>
    <strong>AI is not configured.</strong>
    Set <code>AI_PROVIDER</code> (gemini / openai / ollama) and the matching key or URL in your <code>.env</code> file, then restart.
    Everything else in the dashboard works without AI.
  </div>
<% } %>

<div class="row g-3">
  <div class="col-md-6">
    <div class="card">
      <div class="card-body">
        <h6 class="text-secondary text-uppercase small mb-3">Analyze an Alert</h6>
        <div class="mb-2">
          <select id="alertSelect" class="form-select form-select-sm" <%= aiEnabled ? '' : 'disabled' %>>
            <option value="">Select an alert...</option>
            <% alerts.forEach(a => { %>
              <option value="<%= a.id %>">#<%= a.id %> — <%= a.title %> (<%= a.severity %>)</option>
            <% }) %>
          </select>
        </div>
        <button id="analyzeBtn" class="btn btn-danger btn-sm w-100" <%= aiEnabled ? '' : 'disabled' %>>
          <i class="bi bi-robot me-1"></i>Analyze with AI
        </button>
        <div id="analysisOutput" class="mt-3 small text-secondary" style="white-space: pre-wrap;"></div>
      </div>
    </div>
  </div>

  <div class="col-md-6">
    <div class="card">
      <div class="card-body">
        <h6 class="text-secondary text-uppercase small mb-3">SOC Chatbot</h6>
        <div id="chatLog" class="mb-2 small" style="max-height: 300px; overflow-y: auto;"></div>
        <div class="input-group input-group-sm">
          <input type="text" id="chatInput" class="form-control" placeholder="e.g. Show me today's critical alerts" <%= aiEnabled ? '' : 'disabled' %>>
          <button id="chatBtn" class="btn btn-danger" <%= aiEnabled ? '' : 'disabled' %>>Send</button>
        </div>
        <div class="text-secondary small mt-2">
          The chatbot can only read dashboard stats, alerts, incidents, and recent logs. It cannot run commands or SQL.
        </div>
      </div>
    </div>
  </div>
</div>
