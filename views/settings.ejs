<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h3 class="mb-0">Settings</h3>
    <div class="text-secondary small">Configuration overview and audit trail</div>
  </div>
</div>

<div class="row g-3 mb-3">
  <div class="col-md-6">
    <div class="card"><div class="card-body">
      <h6 class="text-secondary text-uppercase small mb-3">Your Account</h6>
      <div class="small">
        <div><strong>Name:</strong> <%= currentUser.name %></div>
        <div><strong>Username:</strong> <%= currentUser.username %></div>
        <div><strong>Role:</strong> <span class="badge bg-secondary"><%= currentUser.role %></span></div>
      </div>
      <a href="/change-password" class="btn btn-outline-light btn-sm mt-3">Change Password</a>
    </div></div>
  </div>

  <div class="col-md-6">
    <div class="card"><div class="card-body">
      <h6 class="text-secondary text-uppercase small mb-3">Integrations</h6>
      <div class="small mb-2">
        <strong>AI Provider:</strong>
        <% if (aiEnabled) { %>
          <span class="badge bg-success"><%= aiProvider %></span>
        <% } else { %>
          <span class="badge bg-secondary">Disabled</span>
        <% } %>
      </div>
      <div class="small">
        <strong>Threat Intel:</strong>
        <% if (tiProviders.length === 0) { %>
          <span class="badge bg-secondary">Not configured</span>
        <% } else { %>
          <% tiProviders.forEach(p => { %><span class="badge bg-success me-1"><%= p.name %></span><% }) %>
        <% } %>
      </div>
      <div class="text-secondary small mt-3">
        These are configured via environment variables in <code>.env</code>. API keys are never sent to the browser.
      </div>
    </div></div>
  </div>
</div>

<div class="card">
  <div class="card-body pb-0"><h6 class="text-secondary text-uppercase small mb-3">Audit Log (last 50 actions)</h6></div>
  <div class="table-responsive">
    <table class="table table-dark table-sm align-middle mb-0">
      <thead><tr><th>Time</th><th>User</th><th>Action</th><th>Target</th><th>IP</th></tr></thead>
      <tbody>
        <% if (auditLogs.length === 0) { %>
          <tr><td colspan="5" class="text-center text-secondary py-3">No audit entries yet.</td></tr>
        <% } %>
        <% auditLogs.forEach(log => { %>
          <tr>
            <td class="small text-secondary"><%= new Date(log.created_at).toLocaleString() %></td>
            <td class="small"><%= log.user ? log.user.username : '—' %></td>
            <td class="small"><%= log.action %></td>
            <td class="small text-secondary"><%= log.target || '—' %></td>
            <td class="small text-secondary"><%= log.ip || '—' %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>
