<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h3 class="mb-0">Incidents</h3>
    <div class="text-secondary small"><%= incidents.length %> incident(s)</div>
  </div>
</div>

<div class="card mb-3">
  <div class="card-body">
    <form method="GET" action="/incidents" class="row g-2 align-items-end">
      <div class="col-md-3">
        <label class="form-label small text-secondary">Status</label>
        <select name="status" class="form-select form-select-sm">
          <option value="">All</option>
          <% ['OPEN','INVESTIGATING','CONTAINED','RESOLVED','CLOSED'].forEach(s => { %>
            <option value="<%= s %>" <%= filters.status === s ? 'selected' : '' %>><%= s %></option>
          <% }) %>
        </select>
      </div>
      <div class="col-md-3">
        <label class="form-label small text-secondary">Severity</label>
        <select name="severity" class="form-select form-select-sm">
          <option value="">All</option>
          <% ['CRITICAL','HIGH','MEDIUM','LOW'].forEach(s => { %>
            <option value="<%= s %>" <%= filters.severity === s ? 'selected' : '' %>><%= s %></option>
          <% }) %>
        </select>
      </div>
      <div class="col-md-2">
        <button type="submit" class="btn btn-danger btn-sm w-100"><i class="bi bi-search"></i> Filter</button>
      </div>
    </form>
  </div>
</div>

<div class="card">
  <div class="table-responsive">
    <table class="table table-dark table-hover align-middle mb-0">
      <thead><tr><th>ID</th><th>Title</th><th>Severity</th><th>Status</th><th>Assigned</th><th>Created</th></tr></thead>
      <tbody>
        <% if (incidents.length === 0) { %>
          <tr><td colspan="6" class="text-center text-secondary py-4">No incidents yet. Open an alert and click "Create Incident" to escalate it.</td></tr>
        <% } %>
        <% incidents.forEach(inc => { %>
          <tr style="cursor:pointer" onclick="window.location='/incidents/<%= inc.id %>'">
            <td class="small text-secondary">#<%= inc.id %></td>
            <td class="small"><%= inc.title %></td>
            <td>
              <% const bc = { CRITICAL:'badge-critical', HIGH:'badge-high', MEDIUM:'badge-medium', LOW:'badge-low' }[inc.severity] || 'badge-info'; %>
              <span class="badge <%= bc %>"><%= inc.severity %></span>
            </td>
            <td><span class="badge bg-secondary"><%= inc.status %></span></td>
            <td class="small"><%= inc.assigned_to || '—' %></td>
            <td class="small text-secondary"><%= new Date(inc.created_at).toLocaleString() %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>
